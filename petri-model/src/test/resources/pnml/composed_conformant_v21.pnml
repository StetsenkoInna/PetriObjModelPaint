<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name>
      <text>PipelineDemo</text>
    </name>
    <page id="object0">
      <name>
        <text>Generator</text>
      </name>
      <toolspecific tool="PetriObjModel" version="2.2.2">
        <petriObject index="0" name="Generator" priority="1" x="40" y="60"/>
      </toolspecific>
      <place id="p_pool">
        <name>
          <text>Pool</text>
        </name>
        <initialMarking>
          <text>5</text>
        </initialMarking>
        <graphics>
          <position x="60" y="80"/>
        </graphics>
      </place>
      <!-- This place is shared with "p_in", which holds the marking for both. -->
      <referencePlace id="p_ready" ref="p_in">
        <name>
          <text>Ready</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.2.2">
          <referenceRole>fusion</referenceRole>
        </toolspecific>
        <graphics>
          <position x="200" y="80"/>
        </graphics>
      </referencePlace>
      <place id="p_log">
        <name>
          <text>Log</text>
        </name>
        <graphics>
          <position x="200" y="200"/>
        </graphics>
      </place>
      <transition id="t_gen">
        <name>
          <text>Generate</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.2.2">
          <timeDelay>1.0</timeDelay>
          <delayMeanValue>1.0</delayMeanValue>
          <distribution>det</distribution>
          <priority>1</priority>
        </toolspecific>
        <graphics>
          <position x="130" y="80"/>
        </graphics>
      </transition>
      <arc id="a_g1" source="p_pool" target="t_gen">
        <graphics/>
        <inscription>
          <text>1</text>
        </inscription>
      </arc>
      <arc id="a_g2" source="t_gen" target="p_ready">
        <graphics/>
        <inscription>
          <text>1</text>
        </inscription>
      </arc>
      <arc id="a_g3" source="t_gen" target="p_log">
        <graphics/>
        <inscription>
          <text>1</text>
        </inscription>
      </arc>
    </page>
    <page id="object1">
      <name>
        <text>Server</text>
      </name>
      <toolspecific tool="PetriObjModel" version="2.2.2">
        <petriObject index="1" name="Server" priority="0" x="360" y="60"/>
      </toolspecific>
      <place id="p_in">
        <name>
          <text>In</text>
        </name>
        <graphics>
          <position x="60" y="80"/>
        </graphics>
      </place>
      <place id="p_busy">
        <name>
          <text>Busy</text>
        </name>
        <graphics>
          <position x="200" y="80"/>
        </graphics>
      </place>
      <place id="p_done">
        <name>
          <text>Done</text>
        </name>
        <graphics>
          <position x="340" y="80"/>
        </graphics>
      </place>
      <!-- This slot of Server is the place "p_log" of Generator, shared with it. The arc
           from here to "End" is then an ordinary informational arc of Server's own net. -->
      <referencePlace id="p_watch" ref="p_log">
        <name>
          <text>Watch</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.2.2">
          <referenceRole>fusion</referenceRole>
        </toolspecific>
        <graphics>
          <position x="270" y="200"/>
        </graphics>
      </referencePlace>
      <transition id="t_start">
        <name>
          <text>Start</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.2.2">
          <timeDelay>2.0</timeDelay>
          <delayMeanValue>2.0</delayMeanValue>
          <distribution>exp</distribution>
          <priority>1</priority>
        </toolspecific>
        <graphics>
          <position x="130" y="80"/>
        </graphics>
      </transition>
      <transition id="t_end">
        <name>
          <text>End</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.2.2">
          <timeDelay>3.0</timeDelay>
          <delayMeanValue>3.0</delayMeanValue>
          <distribution>det</distribution>
          <priority>1</priority>
        </toolspecific>
        <graphics>
          <position x="270" y="80"/>
        </graphics>
      </transition>
      <!-- Stands for "Log in Generator", so this page can draw an arc to it. -->
      <referencePlace id="ref_object1_p_log" ref="p_log">
        <name>
          <text>Log</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.2.2">
          <referenceRole>representative</referenceRole>
        </toolspecific>
        <graphics>
          <position x="200" y="200"/>
        </graphics>
      </referencePlace>
      <arc id="a_s1" source="p_in" target="t_start">
        <graphics/>
        <inscription>
          <text>1</text>
        </inscription>
      </arc>
      <arc id="a_s2" source="t_start" target="p_busy">
        <graphics/>
        <inscription>
          <text>1</text>
        </inscription>
      </arc>
      <arc id="a_s3" source="p_busy" target="t_end">
        <graphics/>
        <inscription>
          <text>1</text>
        </inscription>
      </arc>
      <arc id="a_s4" source="t_end" target="p_done">
        <graphics/>
        <inscription>
          <text>1</text>
        </inscription>
      </arc>
      <arc id="a_s5" source="p_watch" target="t_end">
        <graphics/>
        <inscription>
          <text>1</text>
        </inscription>
        <toolspecific tool="PetriObjModel" version="2.2.2">
          <informational>true</informational>
        </toolspecific>
      </arc>
      <arc id="larc_1" source="t_start" target="ref_object1_p_log">
        <graphics/>
        <inscription>
          <text>2</text>
        </inscription>
      </arc>
    </page>
    <toolspecific tool="PetriObjModel" version="2.2.2">
      <petriObjectLinks>
        <link sourceElement="1" sourceElementId="p_ready" sourceObject="0" targetElement="0" targetElementId="p_in" targetObject="1" type="placeFusion"/>
        <link quantity="2" sourceElement="0" sourceElementId="t_start" sourceObject="1" targetElement="2" targetElementId="p_log" targetObject="0" type="transitionToPlace"/>
        <link sourceElement="3" sourceElementId="p_watch" sourceObject="1" targetElement="2" targetElementId="p_log" targetObject="0" type="placeFusion"/>
      </petriObjectLinks>
    </toolspecific>
  </net>
</pnml>
