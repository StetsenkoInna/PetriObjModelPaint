<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ua.stetsenkoinna</groupId>
        <artifactId>petri-parent</artifactId>
        <version>2.7.0</version>
    </parent>

    <artifactId>petri-swing-ui</artifactId>
    <version>2.7.0</version>
    <packaging>jar</packaging>

    <properties>
        <petri.skills.version>0.4.0</petri.skills.version>
        <petri.skills.sha256>445a6dd434d11509eb2f1b82f131f612c211cd234b75d11025581b62422f335e</petri.skills.sha256>
        <petri.skills.url>https://github.com/sergiorbk/petri-modeling-skills/releases/download/v${petri.skills.version}/petri-modeling-skills-${petri.skills.version}-resources.zip</petri.skills.url>
        <petri.skills.cache>${settings.localRepository}/io/github/sergiorbk/petri-modeling-skills-resources/${petri.skills.version}</petri.skills.cache>
        <petri.skills.archive>${petri.skills.cache}/petri-modeling-skills-${petri.skills.version}-resources.zip</petri.skills.archive>
        <petri.skills.resources>${project.build.directory}/generated-resources/shared-skills/${petri.skills.version}-${petri.skills.sha256}</petri.skills.resources>
    </properties>

    <licenses>
        <license>
            <name>PolyForm Noncommercial License 1.0.0</name>
            <url>https://polyformproject.org/licenses/noncommercial/1.0.0</url>
            <distribution>repo</distribution>
            <comments>For commercial licensing, contact inna.stetsenko-fiot@edu.kpi.ua or sergey24rybak@gmail.com</comments>
        </license>
    </licenses>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>ua.stetsenkoinna</groupId>
            <artifactId>petri-math</artifactId>
        </dependency>
        <dependency>
            <groupId>ua.stetsenkoinna</groupId>
            <artifactId>petri-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ua.stetsenkoinna</groupId>
            <artifactId>petri-model</artifactId>
        </dependency>
        <dependency>
            <groupId>org.netbeans.external</groupId>
            <artifactId>AbsoluteLayout</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.auto.service</groupId>
            <artifactId>auto-service</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
        </dependency>
        <!-- SLF4J binding for the standalone desktop app: routes SLF4J to java.util.logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>${petri.skills.resources}</directory>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/*.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <include>**/*.png</include>
                    <include>**/*.PNG</include>
                    <include>**/*.pnml</include>
                    <include>ua/stetsenkoinna/graphpresentation/ai/*.md</include>
                </includes>
            </resource>
            <!-- The module's LICENSE ships inside the JAR under a project-unique path (a bare
                 /LICENSE or /META-INF/LICENSE would collide with dependency jars when shading),
                 so the Help > License dialog always shows the license of the build it is part
                 of without anyone copying the text by hand. -->
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>ua/stetsenkoinna/license</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>LICENSE</include>
                </includes>
            </resource>
            <!-- The JavaFX chart stylesheets live next to LineChartBuilderService under src/main/java
                 rather than under src/main/resources, so without this entry they never reach
                 target/classes at all and ResourcePathConfig.getCssUrl silently returns null. -->
            <resource>
                <directory>src/main/java</directory>
                <filtering>false</filtering>
                <includes>
                    <include>**/*.css</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration><overwrite>true</overwrite></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>download-shared-modeling-skills</id>
                        <phase>generate-resources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${petri.skills.cache}"/>
                                <get src="${petri.skills.url}" dest="${petri.skills.archive}" skipexisting="true" maxtime="60"/>
                                <checksum file="${petri.skills.archive}" algorithm="SHA-256" property="${petri.skills.sha256}" verifyproperty="petri.skills.valid"/>
                                <fail message="Shared modeling skills SHA-256 mismatch. Remove the cached archive and retry.">
                                    <condition><not><equals arg1="${petri.skills.valid}" arg2="true"/></not></condition>
                                </fail>
                                <unzip src="${petri.skills.archive}" dest="${petri.skills.resources}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.auto.service</groupId>
                            <artifactId>auto-service</artifactId>
                            <version>1.1.1</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>ua.stetsenkoinna.PetriObjPaintApp</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
